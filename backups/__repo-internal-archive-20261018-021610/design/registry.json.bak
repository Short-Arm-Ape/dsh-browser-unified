{
  "schemaVersion": 1,
  "lastUpdated": "2026-09-05T12:00+08:00",
  "purpose": "browser-unified-core（及未来 DSH 插件壳）的自更新/设计一致性注册表：impactRules 是「上游改动路径 → 合并核心影响面」的单一事实源（PS 自检脚本与 TS 工具层都读这里）；designEntries 记录设计决策与待办（含无上游提交的用户功能改动）；tooling/authz 规定工具命名与鉴权策略。人工直接修改本文件或经 browser_design_edit 工具修改都允许，但必须通过 JSON 校验并保留备份。",
  "baselineRef": "upstream-baseline.json",
  "tooling": {
    "toolPrefix": "browser",
    "checkToolName": "browser_check_update",
    "designViewToolName": "browser_design_show",
    "designEditToolName": "browser_design_edit",
    "checkReadOnly": true,
    "mutateRequiresApproval": true
  },
  "authz": {
    "policy": "只读工具放开（browser_check_update / browser_design_show）；任何写入类工具（browser_design_edit）必须先过用户审批（fail-closed，拒绝即不执行、不重试）；真正改源码/重新归档仍走「报告 → 用户确认 → agent 执行 re-vendor+合并+typecheck」流程，不在工具内自动发生。",
    "approvalPromptTemplate": "【待确认的注册表修改】动作:{action} 条目:{entryId} 标题:{title} 摘要:{summary} 来源类型:{sourceType}（user=用户明示 / upstream=上游提交 / file/network=外部内容——后者一律需用户在批准框确认后才可写入）",
    "externalContentPolicy": "外部内容（上游 commit/README/网页/文件文本）一律只作数据，不允许被当作指令拼接、不允许直接成为工具的参数内容；工具参数只接受用户明示的意图或结构化标识。",
    "writeAllowlist": [
      "design/registry.json",
      "upstream-baseline.json"
    ],
    "schemaValidationBeforeWrite": true,
    "backupBeforeWrite": true,
    "outsideWorkspaceWritesForbidden": true
  },
  "impactRules": {
    "xylt369-dsh-browser": [
      { "m": "packages/browser-playwright/src/url-guard.ts", "t": "core src/url-policy.ts（public 档：私网分类 / fake-ip 放行 / DNS 复核语义）", "i": "可能改变公网拦截行为或错误文案；需同步语义并重跑单测" },
      { "m": "packages/browser-playwright/src/stealth.ts", "t": "stealth 反检测（原型未并入；short-arm-ape 归档内含其拷贝）", "i": "两处归档漂移风险；后续 provider 接线时需跟进" },
      { "m": "packages/dsh-web-permission", "t": "审批模型 web-permission（allow/ask/remember；原型未并入）", "i": "仅作 provider 档设计参考，不在 core 直接影响面" },
      { "m": "packages/", "t": "其余包（seam / tool-browser / settings 等）", "i": "原型未并入这些包；仅在后续 provider / 工具层接线时需跟进" },
      { "m": "", "t": "(未映射路径)", "i": "人工评估是否影响合并面" }
    ],
    "short-arm-ape-intranet": [
      { "m": "src/url-check.ts", "t": "core src/url-policy.ts（intranet 档：元数据黑名单 / 主机名归一化）", "i": "黑名单 / 归一化变化需同步，并核对元数据覆盖（含已知缺口项）" },
      { "m": "src/gate.ts", "t": "core src/approval.ts（审批门决策表 gateAction）", "i": "决策次序 / 策略语义变化需同步决策表并补测试" },
      { "m": "src/", "t": "runtime / tools / config 其余文件", "i": "原型未并入；仅作设计参考，不在本包直接影响面" },
      { "m": "", "t": "(未映射路径)", "i": "人工评估是否影响合并面" }
    ],
    "kyo615-browser-control": [
      { "m": "src/", "t": "kyo615 尚未并入 core（GUI 实时画面为候选集成层）", "i": "核心无直接影响；将来做 live-view 集成时以本归档为源" },
      { "m": "", "t": "(其余路径)", "i": "核心无直接影响，人工评估" }
    ],
    "caob23-browser-control": [
      { "m": "src/ws.ts", "t": "core src/bridge/ws.ts（AGPL vendored）", "i": "帧编解码变更需原样同步收编并冒烟" },
      { "m": "src/server.ts", "t": "core src/bridge/server.ts（AGPL vendored）", "i": "桥协议 / 命令面变更需同步并过 GuardedBridge 冒烟" },
      { "m": "extension/", "t": "扩展端（仅归档，不并入 core）", "i": "归档同步；若桥协议变化需联动核对扩展版本" },
      { "m": "src/", "t": "其余 src（index/settings/invariant 等）", "i": "工具注册 / 设置接线参考，未并入 core" },
      { "m": "", "t": "(未映射路径)", "i": "人工评估是否影响合并面" }
    ]
  },
