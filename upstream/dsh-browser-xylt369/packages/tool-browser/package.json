{
  "name": "@yeesy369/dsh-tool-browser",
  "version": "0.7.0",
  "type": "module",
  "description": "Model-facing browser tools for DeepSeek Harness over the ctx.browser seam.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "README.en.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"(lint: not configured for dsh-tool-browser)\"",
    "test": "node --import tsx --test test/session.test.ts test/screenshot.test.ts",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@yeesy369/dsh-browser": "workspace:*",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": ">=0.1.0-rc.7 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7 <0.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
