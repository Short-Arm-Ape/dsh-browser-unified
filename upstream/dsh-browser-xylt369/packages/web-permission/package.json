{
  "name": "@yeesy369/dsh-web-permission",
  "version": "0.6.1",
  "type": "module",
  "description": "tools/pre-execute permission gate for web and browser tools (allowlist / denylist / ask).",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "README.en.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/bundle-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "echo \"(lint: not configured for dsh-web-permission)\"",
    "test": "node --import tsx --test test/policy.test.ts test/gate.integration.test.ts test/form.test.ts test/client-bundle.test.ts",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.7 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7 <0.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-settings-plugins"]
    }
  }
}
