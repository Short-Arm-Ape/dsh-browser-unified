+ * unified-tools — the dsh-browser-unified self-update + design-registry tools.
+ *
+ * Registers three model-facing tools beside the bridge's `browser_*` set:
+ *   - browser_check_update    read-only upstream-drift probe (git ls-remote vs baseline)
+ *   - browser_design_show     read-only digest of design/registry.json
+ *   - browser_design_edit     approval-gated writer over design/registry.json
+ *
+ * Data lives in the package `registry/` directory by default (or an absolute
+ * `registryDir` override from settings): upstream-baseline.json (commit pins)
+ * and design/registry.json (design entries / impactRules / authz policy).
+ *
+ * Derived from the design in `design/README.md` of the repository. Part of
+ * browser-unified-plugin, AGPL-3.0 (see NOTICE.md).
+ */
+
+import { execFile } from 'node:child_process'
+import { copyFile, readFile, writeFile } from 'node:fs/promises'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+import type { Context } from '@deepseek-ai/cordis'
+import { defineTool as rawDefineTool } from '@deepseek-ai/dsh-tools'
+
+// Loose wrapper over the real DSL: options are runtime-validated by
+// dsh-tools' assert layer anyway; a wide type keeps our three tools' schema
+// object shapes identical to the ones validated live in the dynamic preview.
+const defineTool = (options: unknown) => rawDefineTool(options as never)
+
+const ENTRY_STATUSES = ['proposed', 'accepted', 'applied', 'rejected', 'superseded'] as const
+const TEXT_OUT = {
+	type: 'object' as const,
+	additionalProperties: false,
+	properties: { ok: { type: 'boolean', required: true }, text: { type: 'string', required: true } },
+}
+
+function registryDirOf(configured: string): string {
+	if (configured.length > 0) return path.resolve(configured)
+	return path.join(path.dirname(fileURLToPath(import.meta.url)), '..', 'registry')
+}
+
+/** 第二部分注册表：调用时的问题（第一部分是 design/registry.json 的功能对齐与计划）。 */
+function issuesFileOf(dir: string): string {
+	return path.join(dir, 'issues', 'issues.json')
+}
+
+/**
+ * 读问题登记簿。读失败（文件缺失/坏 JSON）返回空表而不是抛：它只是提示来源，
+ * 不该让任何一次工具调用因为登记簿读不出来而失败。
+ */
+export async function loadIssues(configuredRegistryDir: string): Promise<{ dir: string; file: string; issues: Record<string, unknown>[] }> {
+	const dir = registryDirOf(configuredRegistryDir)
+	const file = issuesFileOf(dir)
+	try {
+		const parsed = await readJson(file)
+		const issues = Array.isArray(parsed.issues) ? parsed.issues as Record<string, unknown>[] : []
+		return { dir, file, issues }
+	} catch {
+		return { dir, file, issues: [] }
+	}
+}
+
+/** 插件自身版本（登记簿的 fixedIn 默认值）；读不到就写「未标注」。 */
+export async function currentPluginVersion(configuredRegistryDir: string): Promise<string> {
+	try {
+		const pkg = await readJson(path.join(registryDirOf(configuredRegistryDir), '..', 'package.json'))
+		return typeof pkg.version === 'string' ? pkg.version : '未标注'
+	} catch {
+		return '未标注'
+	}
+}
+
+async function readJson(file: string): Promise<Record<string, unknown>> {
+	const parsed: unknown = JSON.parse(await readFile(file, 'utf8'))
+	if (typeof parsed !== 'object' || parsed === null) throw new Error(`not a JSON object: ${file}`)
+	return parsed as Record<string, unknown>
+}
+
+interface GitRun { ok: boolean; out: string; err: string }
+function runGit(args: readonly string[]): Promise<GitRun> {
+	return new Promise((resolve) => {
+		execFile('git', args as string[], { timeout: 25_000, maxBuffer: 1 << 20, windowsHide: true }, (error, stdout, stderr) => {
+			resolve({ ok: !error, out: stdout, err: String(stderr || (error && error.message) || '') })
+		})
+	})
+}
+
+function parseHeadSha(out: string): string | undefined {
+	for (const line of out.split('\n')) {
+		const m = /^([0-9a-f]{40})\tHEAD$/i.exec(line.trim())
+		if (m) return m[1]
+	}
+	return undefined
+}
+
+async function gitHeadSha(url: string): Promise<string> {
+	const first = await runGit(['ls-remote', '--symref', url, 'HEAD'])
+	const sha = parseHeadSha(first.out)
+	if (first.ok && sha) return sha
+	// Environments with no trusted CA (sandboxes / restricted terminals):
+	// openssl backend + read-only TLS verification off. Normal hosts succeed
+	// on the first attempt.
+	const second = await runGit(['-c', 'http.sslBackend=openssl', '-c', 'http.sslVerify=false', 'ls-remote', '--symref', url, 'HEAD'])
+	const sha2 = parseHeadSha(second.out)
+	if (second.ok && sha2) return sha2
+	throw new Error((second.err || first.err).trim().split('\n')[0]?.slice(0, 200) || 'git ls-remote failed')
+}
+
+function renderText(_args: unknown, value: { text: string }): Array<{ type: string; text: string }> {
+	return [{ type: 'text', text: String(value.text) }]
+}
+
+function textResult(text: string): { ok: boolean; text: string } {
+	return { ok: true, text }
+}
+
+function safe(fn: () => Promise<{ ok: boolean; text: string }>, label: string): Promise<{ ok: boolean; text: string }> {
+	return fn().catch((e: unknown) => ({ ok: false, text: `${label}：${e instanceof Error ? e.message : String(e)}` }))
+}
+
+type ApprovalService = {
+	request(req: { agent: { id: string }; toolName: string; reason?: string; signal?: AbortSignal }): Promise<string>
+}
+
+/**
+ * Ask the approval service for one allowed-once grant, and turn **every** failure mode into a plain refusal.
+ *
+ * 为什么要包一层：审批被禁用/未接线时 `approval.request` 会直接抛（实测错误文本是
+ * `Cannot read properties of undefined (reading 'seq')`），而写入类工具本该 fail-closed
+ * **并给出人话**——「未获批准」比一句内部异常更能让模型/用户知道下一步该做什么。
+ * @returns 允许写入时为 undefined，否则返回给模型看的拒绝说明。
+ */
+async function approvalRefusal(ctx: Context, exec: unknown, toolName: string, reason: string): Promise<string | undefined> {
+	const approval = ctx.get('approval') as ApprovalService | undefined
+	const agent = (exec as { agent?: { id?: string } }).agent
+	if (!approval || typeof approval.request !== 'function' || !agent || !agent.id) {
+		return `${toolName}: 审批服务或会话不可用，拒绝写入（fail-closed）；需要写入请在开启审批的会话里重试`
+	}
+	let outcome = ''
+	try {
+		outcome = await approval.request({ agent: { id: agent.id }, toolName, reason, signal: (exec as { signal?: AbortSignal }).signal })
+	} catch (error) {
+		const detail = error instanceof Error ? error.message : String(error)
+		return `${toolName}: 审批请求失败（${detail}），拒绝写入（fail-closed）；请确认审批可用后重试`
+	}
+	if (outcome !== 'allowed-once') return `${toolName}: 未获批准（${outcome}），未写入任何内容`
+	return undefined
+}
