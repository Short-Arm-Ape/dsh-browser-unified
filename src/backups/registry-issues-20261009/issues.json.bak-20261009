{
  "schemaVersion": 1,
  "lastUpdated": "2026-09-29T13:35:00.000Z",
  "purpose": "浏览器插件的**第二部分注册表：调用时的问题**（第一部分 registry/design/registry.json 记「功能对齐与计划」，本文件记「实际调用时踩到的坑」）。用法：模型在某会话里首次调用 browser_* 时会收到 open 问题的绕行摘要（+ 自上次调用以来已修复的问题告知）；完整内容只在调用 browser_issues 时输出，避免每轮占 token。",
  "fields": {
    "status": "open（仍存在，必须给 workaround）| fixed（已修，写 fixedIn）| wontfix（不修，写原因）",
    "symptom": "调用时具体看到什么（报错原文/现象），供模型对照",
    "workaround": "模型可以怎么绕过（open 项必填）",
    "match": "可选正则（大小写不敏感）：工具结果/错误文本命中即视为「本会话撞到过」，用于修复后定向告知",
    "affected": "受影响版本范围",
    "fixedIn": "在哪个版本修复",
    "evidence": "取证（谁的哪个实测、读数）"
  },
